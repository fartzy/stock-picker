load("@aspect_rules_js//js:defs.bzl", "js_run_devserver", "js_test")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//typescript:vite/package_json.bzl", vite_bin = "bin")

npm_link_all_packages()

# Pure calculations run with Bazel's Node toolchain; no test-framework install.
ts_project(
    name = "what_if_calculations",
    srcs = ["src/api.ts", "src/whatIf.ts", "src/newsCheck.ts"],
    declaration = False,
    transpiler = "tsc",
    tsconfig = {"compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": True,
        "types": [],
    }},
)

js_test(
    name = "what_if_test",
    entry_point = "tests/whatIf.test.mjs",
    data = [":what_if_calculations", "package.json"],
)

js_test(
    name = "news_check_test",
    entry_point = "tests/newsCheck.test.mjs",
    data = [":what_if_calculations", "package.json"],
)

ts_project(
    name = "experimental_registry_helpers",
    srcs = ["src/experimentalRegistry.ts"],
    declaration = False,
    transpiler = "tsc",
    tsconfig = {"compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": True,
        "types": [],
    }},
)

js_test(
    name = "experimental_registry_test",
    entry_point = "tests/experimentalRegistry.test.mjs",
    data = [":experimental_registry_helpers", "package.json"],
)

ts_project(
    name = "model_derived_registry_helpers",
    srcs = ["src/modelDerivedRegistry.ts"],
    declaration = False,
    transpiler = "tsc",
    tsconfig = {"compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": True,
        "types": [],
    }},
)

js_test(
    name = "model_derived_registry_test",
    entry_point = "tests/modelDerivedRegistry.test.mjs",
    data = [":model_derived_registry_helpers", "package.json"],
)

ts_project(
    name = "typecheck",
    srcs = glob([
        "src/**/*.ts",
        "src/**/*.tsx",
    ]),
    declaration = False,
    no_emit = True,
    tsconfig = "tsconfig.json",
    deps = [
        ":node_modules/@types/react",
        ":node_modules/@types/react-dom",
        ":node_modules/react",
        ":node_modules/react-dom",
    ],
)

vite_bin.vite_binary(
    name = "vite",
)

js_run_devserver(
    name = "dev",
    args = ["dev"],
    chdir = package_name(),
    data = [
        "index.html",
        "tsconfig.json",
        "vite.config.ts",
        ":node_modules/@types/react",
        ":node_modules/@types/react-dom",
        ":node_modules/@vitejs/plugin-react",
        ":node_modules/react",
        ":node_modules/react-dom",
        ":node_modules/typescript",
        ":node_modules/vite",
    ] + glob([
        "src/**",
        "public/**",
    ]),
    tool = ":vite",
)
