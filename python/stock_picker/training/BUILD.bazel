load("@rules_python//python:defs.bzl", "py_binary", "py_library")

# mlflow 3.x splits the mlflow/ namespace across several wheels; the modules_mapping
# resolver picks mlflow-tracing, but train.py's classic tracking API
# (start_run/log_params/log_metrics) lives in the full mlflow wheel.
# gazelle:resolve py mlflow @pypi//mlflow

