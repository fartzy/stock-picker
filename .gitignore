# data/ (prices/features/models/universe/trades/training runs/mlflow) is
# tracked in git so a fresh clone gets a working, already-trained app with
# no pipeline runs required. Regeneratable, but committed anyway for a
# turnkey checkout -- accepted tradeoff: future regenerations of the bulkier
# subdirectories (features/, prices/) add their full size again to git
# history each time, since parquet doesn't diff.
bazel-*
.claude/
__pycache__/
*.pyc
.bazelrc.user
.env
data/buy_signals/*
!data/buy_signals/.gitkeep
data/news/*
!data/news/.gitkeep
data/morning_checks/*
!data/morning_checks/.gitkeep
data/ticker_blacklist/*
!data/ticker_blacklist/blacklist.json
.idea/
# SQLite WAL sidecar -- the .db is the source of truth (trades, later scans).
*.db-wal
*.db-shm
langfuse/.env
typescript/node_modules/
typescript/dist/
typescript/*.tsbuildinfo
